---
import Base from '../layouts/Base.astro';
import SlashNav from '../components/SlashNav.astro';
---
<Base title="Resume — Kevin's Field Journal">
  <main class="page">
    <article>
      <SlashNav active="/resume" />
      <h1 class="stub-title">resume</h1>
      <p class="stub-note">
        <a href="/Kevin Medina Eng_Resume.pdf" class="pdf-link">Download PDF →</a>
      </p>
    </article>
  </main>
</Base>
<style>
  .page { max-width: 760px; margin: 0 auto; padding: 28px 40px 36px; }
  .stub-title { font-family: var(--serif); font-weight: 400; font-size: 30px; color: var(--fg); font-style: italic; margin: 0 0 12px; letter-spacing: -0.3px; }
  .stub-note { font-family: var(--mono); font-size: 11px; color: var(--dim); }
  .pdf-link { color: var(--accent); }
  @media (max-width: 640px) { .page { padding: 20px 20px 28px; } }
</style>
