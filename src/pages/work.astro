---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SlashNav from '../components/SlashNav.astro';
import Sidebar from '../components/Sidebar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { atWork, sideProjects, archive, sidebarStats } from '../data/work';
---
<Base title="Work — Kevin's Field Journal">
  <main class="page">
    <article>
      <Eyebrow sub="work · the trail of tools" />
      <h1 class="title">Things I've <em>helped build</em>.</h1>
      <p class="tagline">Day-job projects, side tools, and the little experiments that escaped into the wild.</p>
      <SlashNav active="/work" />

      <div class="label">❦ at work</div>
      <div class="project-list">
        {atWork.map(p => <ProjectCard project={p} />)}
      </div>

      <div class="label" style="margin-top: 24px;">❦ side projects</div>
      <div class="project-list">
        {sideProjects.map(p => <ProjectCard project={p} />)}
      </div>

      <div class="divider-label">❦ archive</div>
      <p style="font-size: 13px; color: var(--dim); font-family: var(--mono); line-height: 1.8; margin: 0;">
        {archive.map((item, i) => (
          <>
            <a href={item.href} style="color: var(--dim);">{item.label}</a>
            {i < archive.length - 1 && <span> · </span>}
          </>
        ))}
      </p>
    </article>

    <Sidebar>
      <div class="block">
        <div class="heading">tools of choice</div>
        <div>
          {sidebarStats.tools.map((t, i) => (
            <>{t}{i < sidebarStats.tools.length - 1 && <br />}</>
          ))}
        </div>
      </div>
      <div class="block">
        <div class="heading">commits this yr</div>
        <div class="body" style="color: var(--accent); font-size: 18px;">{sidebarStats.commits.toLocaleString()}</div>
        <div>across {sidebarStats.repoCount} repos</div>
      </div>
      <div class="block">
        <div class="heading">on github</div>
        <div><a href={sidebarStats.githubUrl} style="color: var(--accent);">{sidebarStats.githubUrl}</a></div>
      </div>
    </Sidebar>
  </main>
</Base>
