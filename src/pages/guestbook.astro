---
import Base from '../layouts/Base.astro';
import SlashNav from '../components/SlashNav.astro';
import GuestbookForm from '../components/GuestbookForm';
import { createClient } from '@supabase/supabase-js';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

let initialEntries: { id: number; name: string; message: string; created_at: string }[] = [];

if (supabaseUrl && supabaseKey) {
  const supabase = createClient(supabaseUrl, supabaseKey);
  const { data } = await supabase
    .from('guestbook')
    .select('*')
    .order('created_at', { ascending: false })
    .limit(50);
  initialEntries = data ?? [];
}
---
<Base title="Guestbook — Kevin's Field Journal">
  <main class="page">
    <article>
      <SlashNav active="/guestbook" />
      <GuestbookForm initialEntries={initialEntries} client:load />
    </article>
  </main>
</Base>

<style>
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 40px 36px;
  }
</style>
