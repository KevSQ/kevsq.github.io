---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SlashNav from '../components/SlashNav.astro';
import Sidebar from '../components/Sidebar.astro';
import BookCard from '../components/BookCard.astro';
import { nightstand, recentlyFinished, queue, booksReadThisYear } from '../data/books';
---
<Base title="Reading — Kevin's Field Journal">
  <main class="page">
    <article>
      <Eyebrow sub="reading · the bookshelf" />
      <h1 class="title">A small <em>shelf</em>.</h1>
      <p class="tagline">What I've been reading, slowly. Updated when something sticks.</p>
      <SlashNav active="/reading" />

      <div class="stat-line">
        <span><strong>{booksReadThisYear}</strong> read this year</span>
        <span><strong>{nightstand.length}</strong> on the nightstand</span>
        <span><strong>{queue.length}+</strong> in the queue</span>
      </div>

      <div class="label">❦ on the nightstand</div>
      {nightstand.map(book => <BookCard book={book} />)}

      <div class="label" style="margin-top: 24px;">❦ recently finished</div>
      {recentlyFinished.map(book => <BookCard book={book} />)}

      <div class="divider-label">❦ on the queue</div>
      <p class="prose" style="color: var(--dim); font-size: 13.5px;">
        {queue.map((title, i) => (
          <>
            {i > 0 && ' · '}
            <em>{title}</em>
          </>
        ))}
        {' '}and more. The queue always grows faster than I read.
      </p>
    </article>

    <Sidebar>
      <div class="block">
        <div class="heading">this year</div>
        <div class="body" style="color: var(--accent); font-size: 18px;">{booksReadThisYear}</div>
        <div>books read</div>
      </div>
      <div class="block">
        <div class="heading">key</div>
        <div>📖 in progress<br/>🔁 re-read<br/>🌱 learning<br/>★ rating</div>
      </div>
      <div class="block">
        <div class="heading">elsewhere</div>
        <div>
          <a href="https://app.thestorygraph.com" style="color: var(--accent);">storygraph</a><br/>
          <a href="/feed.xml" style="color: var(--accent);">/feed.xml</a>
        </div>
      </div>
    </Sidebar>
  </main>
</Base>

<style>
  .stat-line {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--dim);
    margin-bottom: 6px;
  }
  .stat-line strong {
    color: var(--accent);
    font-weight: 500;
  }
</style>
