---
import Base from '../../layouts/Base.astro';
import SlashNav from '../../components/SlashNav.astro';
import { getCollection } from 'astro:content';
import WritingCard from '../../components/WritingCard.astro';
import { statusLabel } from '../../lib/writing';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Writing — Kevin's Field Journal">
  <main class="page">
    <article>
      <SlashNav active="/writing" />
      <div class="label">❦ all writing</div>
      {posts.map(post => (
        <WritingCard
          post={post}
          label={post.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
          statusLabel={statusLabel(post.data.status)}
        />
      ))}
    </article>
  </main>
</Base>

<style>
  .page  { max-width: 760px; margin: 0 auto; padding: 28px 40px 36px; }
  .label { font-family: var(--mono); font-size: 10.5px; color: var(--dim); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 10px; }
  @media (max-width: 640px) {
    .page { padding: 20px 20px 28px; }
  }
</style>
