---
import Base from '../../layouts/Base.astro';
import SlashNav from '../../components/SlashNav.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} — Kevin's Field Journal`}>
  <main class="page">
    <article>
      <SlashNav active="/writing" />
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <span>{post.data.status === 'budding' ? '🌱 budding' : '🌳 evergreen'}</span>
        <span>·</span>
        <span>
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </span>
      </div>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Base>

<style>
  .page { max-width: 760px; margin: 0 auto; padding: 28px 40px 36px; }

  .post-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.15;
    color: var(--fg);
    margin: 0 0 8px;
    letter-spacing: -0.3px;
    font-style: italic;
  }

  .post-meta {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--dim);
    margin-bottom: 28px;
    display: flex;
    gap: 6px;
  }

  .prose { font-size: 15px; line-height: 1.7; color: var(--fg); }
  .prose h2 { font-family: var(--serif); font-weight: 400; font-size: 22px; color: var(--fg); margin: 32px 0 8px; letter-spacing: -0.2px; }
  .prose h3 { font-family: var(--serif); font-weight: 400; font-size: 18px; color: var(--fg); margin: 24px 0 6px; }
  .prose p  { margin: 0 0 1em; }
  .prose a  { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose ul, .prose ol { margin: 0 0 1em; padding-left: 1.4em; }
  .prose li { margin-bottom: 0.3em; }
  .prose blockquote { margin: 0 0 1em 0; padding-left: 14px; border-left: 2px solid var(--border); color: var(--dim); font-style: italic; }
  .prose code { font-family: var(--mono); font-size: 13px; background: var(--panel); padding: 2px 5px; }
  .prose pre { background: var(--panel); padding: 16px; overflow-x: auto; font-family: var(--mono); font-size: 13px; line-height: 1.55; margin: 0 0 1em; }
  .prose pre code { background: none; padding: 0; }
</style>
