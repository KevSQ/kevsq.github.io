---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SlashNav from '../components/SlashNav.astro';
import Sidebar from '../components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { fetchGuestbookEntries } from '../lib/supabase-server';
import WritingCard from '../components/WritingCard.astro';
import { nowItems } from '../data/now';
import { profile } from '../data/profile';
import { statusLabel } from '../lib/writing';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const guestbookEntries = await fetchGuestbookEntries(5);

function tendedLabel(date: Date): string {
  const days = Math.floor((Date.now() - date.valueOf()) / 86_400_000);
  if (days < 1)  return 'tended today';
  if (days === 1) return 'tended yesterday';
  if (days < 7)  return `tended ${days} days ago`;
  if (days < 14) return 'tended last week';
  if (days < 30) return `tended ${Math.floor(days / 7)} weeks ago`;
  if (days < 60) return 'tended last month';
  return `tended ${Math.floor(days / 30)} months ago`;
}
---

<Base>
  <main class="page">
    <article>
      <Eyebrow />

      <h1 class="title">Kevin's <em>field journal</em></h1>
      <p class="tagline">Notes from a software engineer who reads more than he ships. Pruned weekly.</p>

      <SlashNav active="/" />

      <div class="label">❦ recently tended</div>

      {posts.map(post => (
        <WritingCard
          post={post}
          label={tendedLabel(post.data.date)}
          statusLabel={statusLabel(post.data.status)}
        />
      ))}

      <div class="label gardener-label">❦ from the gardener</div>
      <p class="gardener">{profile.shortBio}</p>
    </article>

    <Sidebar>
      <div class="block">
        <div class="heading">now</div>
        <div class="body">
          {nowItems.map((item, i) => (
            <>{item}{i < nowItems.length - 1 && <br />}</>
          ))}
        </div>
      </div>
      <div class="block">
        <div class="heading">✎ guestbook</div>
        {guestbookEntries.length === 0 ? (
          <div style="font-size:10px; color:var(--dim); margin-bottom:6px;">no entries yet</div>
        ) : (
          guestbookEntries.map(entry => (
            <div style="margin-bottom:8px;">
              <div style="font-family:var(--hand); color:var(--fg); font-size:12.5px; line-height:1.3; word-break:break-word;">"{entry.message}"</div>
              <div style="font-size:9.5px;">— {entry.name}</div>
            </div>
          ))
        )}
        <a style="color:var(--accent); margin-top:6px; display:inline-block;" href="/guestbook">+ sign →</a>
      </div>
    </Sidebar>
  </main>
</Base>

<style>
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 40px 36px;
    display: grid;
    grid-template-columns: 1fr 150px;
    gap: 24px;
  }

  h1.title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 36px;
    line-height: 1.1;
    margin: 4px 0 6px;
    letter-spacing: -0.5px;
    color: var(--fg);
  }
  h1.title em {
    color: var(--accent);
    font-style: italic;
  }

  .tagline {
    font-size: 14.5px;
    color: var(--dim);
    font-style: italic;
    margin: 0 0 16px;
    line-height: 1.55;
  }

  .label {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 10px;
  }
  .gardener-label {
    margin: 22px 0 8px;
  }

  .gardener {
    font-size: 14.5px;
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 640px) {
    .page {
      grid-template-columns: 1fr;
      padding: 20px 20px 28px;
    }
  }
</style>
