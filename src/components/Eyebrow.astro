---
import { getEyebrow } from '../config/site';
const { vol, sub } = getEyebrow();
---
<div class="eyebrow">
  <span>{vol} ·</span>
  <span class="dim">{sub}</span>
</div>

<style>
  .eyebrow {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 2px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }
  .dim {
    color: var(--dim);
  }
</style>
