---
import { fetchGuestbookEntries } from '../lib/supabase-server';
const entries = await fetchGuestbookEntries(5);
---
<aside>
 <pre id="flora" class="flora"></pre>

  <div class="block">
    <div class="heading">now</div>
    <div class="body">📖 doing science<br/>🛠 feed reader<br/>🌱 ocaml</div>
  </div>

  <div class="block">
    <div class="heading">✎ guestbook</div>
    {entries.length === 0 ? (
      <div class="gb-empty">no entries yet</div>
    ) : (
      entries.map(entry => (
        <div class="gb-entry">
          <div class="gb-quote">"{entry.message}"</div>
          <div class="gb-author">— {entry.name}</div>
        </div>
      ))
    )}
    <a class="gb-link" href="/guestbook">+ sign →</a>
  </div>
</aside>

<script>
  const frames = [
`   \\ | /
  --✱--
   / | \\
    |||
   \\\\|//
~~~~~~~~~~`,

`   \\ | /
  --✲--
   / | \\
    |||
   \\\\|//
~~~~~~~~~~`,

`   \\ | /
  --✳--
   / | \\
    |||
   \\\\|//
~~~~~~~~~~`
  ];

  let i = 0;
  const el = document.getElementById("flora");

  setInterval(() => {
    el.textContent = frames[i % frames.length];
    i++;
  }, 500);
</script>

<style>
  aside {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--dim);
    padding-top: 38px;
    line-height: 1.55;
  }

  pre.flora {
    color: var(--moss);
    font-size: 9.5px;
    margin: 0;
    white-space: pre;
    line-height: 1.05;
    font-family: var(--mono);
    overflow-x: auto;
  }

  .block {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px dashed var(--border);
  }

  .heading {
    color: var(--accent);
    margin-bottom: 4px;
  }

  .body {
    color: var(--fg);
    line-height: 1.5;
  }

  .gb-entry {
    margin-bottom: 8px;
  }

  .gb-quote {
    font-family: var(--hand);
    color: var(--fg);
    font-size: 12.5px;
    line-height: 1.3;
    word-break: break-word;
    white-space: normal;
  }

  .gb-author {
    font-size: 9.5px;
  }

  .gb-empty {
    font-size: 10px;
    color: var(--dim);
    margin-bottom: 6px;
  }

  .gb-link {
    color: var(--accent);
    margin-top: 6px;
    display: inline-block;
  }

  @media (max-width: 640px) {
    aside {
      padding-top: 0;
    }
  }
</style>
