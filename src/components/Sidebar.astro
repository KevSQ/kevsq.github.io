---
// src/components/Sidebar.astro
---
<aside>
  <pre class="flora">   \ | /
  --✱--
   / | \
    |||
   \\|//
~~~~~~~~~~</pre>

  <div class="block">
    <div class="heading">now</div>
    <div class="body">📖 doing science<br/>🛠 feed reader<br/>🌱 ocaml</div>
  </div>

  <div class="block">
    <div class="heading">✎ guestbook</div>
    <div class="gb-quote">"sent it to my team"</div>
    <div class="gb-author">— mira · 2d</div>
    <div class="gb-quote second">"hi from london"</div>
    <div class="gb-author">— jules · 1w</div>
    <a class="gb-link" href="/guestbook">+ sign →</a>
  </div>
</aside>

<style>
  aside {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--dim);
    padding-top: 38px;
    line-height: 1.55;
  }

  pre.flora {
    color: var(--moss);
    font-size: 9.5px;
    margin: 0;
    white-space: pre;
    line-height: 1.05;
    font-family: var(--mono);
  }

  .block {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px dashed var(--border);
  }

  .heading {
    color: var(--accent);
    margin-bottom: 4px;
  }

  .body {
    color: var(--fg);
    line-height: 1.5;
  }

  .gb-quote {
    font-family: var(--hand);
    color: var(--fg);
    font-size: 12.5px;
    line-height: 1.3;
  }

  .gb-quote.second {
    margin-top: 6px;
  }

  .gb-author {
    font-size: 9.5px;
  }

  .gb-link {
    color: var(--accent);
    margin-top: 6px;
    display: inline-block;
  }

  @media (max-width: 640px) {
    aside {
      padding-top: 0;
    }
  }
</style>
