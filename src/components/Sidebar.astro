---
import { fetchGuestbookEntries } from '../lib/supabase-server';
const entries = await fetchGuestbookEntries(5);
---
<aside>
 <pre id="flora" class="flora"></pre>

  <div class="block">
    <div class="heading">now</div>
    <div class="body">📖 doing science<br/>🛠 feed reader<br/>🌱 ocaml</div>
  </div>

  <div class="block">
    <div class="heading">✎ guestbook</div>
    {entries.length === 0 ? (
      <div class="gb-empty">no entries yet</div>
    ) : (
      entries.map(entry => (
        <div class="gb-entry">
          <div class="gb-quote">"{entry.message}"</div>
          <div class="gb-author">— {entry.name}</div>
        </div>
      ))
    )}
    <a class="gb-link" href="/guestbook">+ sign →</a>
  </div>
</aside>

<script>
  const ANIMS = [
    // 1. Spinning flower — moss
    {
      color: 'var(--moss)',
      ms: 200,
      frames: [
`   \\ | /
   ─(✶)─
   / | \\
    |||
   \\\\|//
~~~~~~~~~~`,
`   ─ | ─
   \\(✶)/
   ─ | ─
    |||
   \\\\|//
~~~~~~~~~~`,
`   / | \\
   ─(✶)─
   \\ | /
    |||
   \\\\|//
~~~~~~~~~~`,
`   ─ | ─
   /(✶)\\
   ─ | ─
    |||
   \\\\|//
~~~~~~~~~~`,
      ]
    },
    // 2. Blinking cat — brass
    {
      color: 'var(--accent)',
      ms: 500,
      frames: [
`  /\\_/\\
 ( ^.^ )
  > ~ <
    |
   / \\
~~~~~~~~~~`,
`  /\\_/\\
 ( -.^ )
  > ~ <
    |
   / \\
~~~~~~~~~~`,
`  /\\_/\\
 ( ^.- )
  > ~ <
    |
   / \\
~~~~~~~~~~`,
`  /\\_/\\
 ( -.- )
  > u <
    |
   / \\
~~~~~~~~~~`,
      ]
    },
    // 3. Bouncing ball — sky
    {
      color: 'var(--sky)',
      ms: 130,
      frames: [
`    ●




~~~~~~~~~~`,
`
    ●



~~~~~~~~~~`,
`

    ●


~~~~~~~~~~`,
`


    ●

~~~~~~~~~~`,
`



   (●)
~~~~~~~~~~`,
`


    ●

~~~~~~~~~~`,
`

    ●


~~~~~~~~~~`,
`
    ●



~~~~~~~~~~`,
      ]
    },
    // 4. Waving figure — terra
    {
      color: 'var(--terra)',
      ms: 250,
      frames: [
`   \\o/
    |
    |
   / \\

~~~~~~~~~~`,
`    o─
    |
    |
   / \\

~~~~~~~~~~`,
`   /o\\
    |
    |
   / \\

~~~~~~~~~~`,
`   ─o
    |
    |
   / \\

~~~~~~~~~~`,
      ]
    },
  ];

  const anim = ANIMS[Math.floor(Math.random() * ANIMS.length)];
  const el = document.getElementById('flora');
  el.style.color = anim.color;
  el.textContent = anim.frames[0];
  let frame = 1;
  setInterval(() => {
    el.textContent = anim.frames[frame % anim.frames.length];
    frame++;
  }, anim.ms);
</script>

<style>
  aside {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--dim);
    padding-top: 38px;
    line-height: 1.55;
  }

  pre.flora {
    color: var(--moss);
    font-size: 9.5px;
    margin: 0;
    white-space: pre;
    line-height: 1.05;
    font-family: var(--mono);
    overflow-x: auto;
  }

  .block {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px dashed var(--border);
  }

  .heading {
    color: var(--accent);
    margin-bottom: 4px;
  }

  .body {
    color: var(--fg);
    line-height: 1.5;
  }

  .gb-entry {
    margin-bottom: 8px;
  }

  .gb-quote {
    font-family: var(--hand);
    color: var(--fg);
    font-size: 12.5px;
    line-height: 1.3;
    word-break: break-word;
    white-space: normal;
  }

  .gb-author {
    font-size: 9.5px;
  }

  .gb-empty {
    font-size: 10px;
    color: var(--dim);
    margin-bottom: 6px;
  }

  .gb-link {
    color: var(--accent);
    margin-top: 6px;
    display: inline-block;
  }

  @media (max-width: 640px) {
    aside {
      padding-top: 0;
    }
  }
</style>
