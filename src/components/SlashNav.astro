---
import { navLinks } from '../data/navigation';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;
---
<nav class="slash">
  {navLinks.map(link => (
    <a href={link.href} class={active === link.href ? 'active' : ''}>
      {link.label}
    </a>
  ))}
</nav>

<style>
  .slash {
    display: flex;
    gap: 14px;
    font-family: var(--mono);
    font-size: 11.5px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .slash a {
    color: var(--dim);
    padding-bottom: 2px;
  }
  .slash a.active {
    color: var(--accent);
    border-bottom: 1.5px solid var(--accent);
  }
  .slash a:hover {
    color: var(--fg);
  }
</style>
