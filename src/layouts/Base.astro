---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = "Kevin — Field Journal" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Caveat:wght@400;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <slot />
</body>
</html>
